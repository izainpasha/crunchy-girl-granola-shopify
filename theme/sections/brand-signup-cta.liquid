{%- comment -%}
  Centered closing CTA used on the About page: scoop icon, "Go Crunchy"
  eyebrow, heading, and the shared email signup form.
{%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="brand-signup-cta">
      {%- if section.settings.heading != blank -%}
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- assign signup_cta_id_prefix = 'SignupCta-' | append: section.id -%}
      {%- render 'brand-email-signup',
        eyebrow: section.settings.signup_eyebrow,
        eyebrow_icon: 'scoop',
        placeholder: section.settings.signup_placeholder,
        button_label: section.settings.signup_button_label,
        microcopy: section.settings.signup_microcopy,
        id_prefix: signup_cta_id_prefix
      -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Signup CTA",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first bag."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "signup_eyebrow",
      "label": "Signup eyebrow",
      "default": "Go Crunchy"
    },
    {
      "type": "text",
      "id": "signup_placeholder",
      "label": "Email placeholder",
      "default": "you@sweethome.com"
    },
    {
      "type": "text",
      "id": "signup_button_label",
      "label": "Button label",
      "default": "Get my 10% off"
    },
    {
      "type": "text",
      "id": "signup_microcopy",
      "label": "Microcopy",
      "default": "Join the crunch club for fresh-batch drops, new flavors, and Texas-sized discounts."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Signup CTA"
    }
  ]
}
{% endschema %}
