{% if cart == empty %}
  <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
{% else %}
  <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
{% endif %}

<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
{%- if cart != empty -%}
  {%- capture brand_cart_count -%}{%- render 'brand-cart-count' -%}{%- endcapture -%}
  {%- assign brand_cart_count = brand_cart_count | strip | plus: 0 -%}
  <div class="cart-count-bubble">
    {%- if brand_cart_count < 100 -%}
      <span aria-hidden="true">{{ brand_cart_count }}</span>
    {%- endif -%}
    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: brand_cart_count }}</span>
  </div>
{%- endif -%}
