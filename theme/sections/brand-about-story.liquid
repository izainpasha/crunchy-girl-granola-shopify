{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="brand-about-reference color-{{ section.settings.color_scheme }} gradient">
  <div class="brand-about-reference__inner section-{{ section.id }}-padding">
    {%- if section.settings.eyebrow != blank -%}
      <p class="brand-about-reference__eyebrow brand-script">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="brand-about-reference__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    <figure class="brand-about-reference__figure">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1440
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '480, 720, 960, 1200, 1440',
            sizes: '(min-width: 750px) 720px, calc(100vw - 48px)',
            class: 'brand-about-reference__image',
            alt: section.settings.image_alt
        }}
      {%- else -%}
        <img
          src="{{ 'gina-granola-bag.jpg' | asset_url }}"
          class="brand-about-reference__image"
          alt="{{ section.settings.image_alt | escape }}"
          loading="eager"
          fetchpriority="high"
          width="1440"
          height="1920"
        >
      {%- endif -%}
      {%- if section.settings.caption != blank -%}
        <figcaption class="brand-about-reference__caption">{{ section.settings.caption | escape }}</figcaption>
      {%- endif -%}
    </figure>

    {%- if section.settings.story != blank -%}
      <div class="brand-about-reference__story rte">{{ section.settings.story }}</div>
    {%- endif -%}

    {%- if section.settings.signature != blank -%}
      <p class="brand-about-reference__signature brand-script">{{ section.settings.signature | escape }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="brand-about-reference__actions">
        <a
          class="brand-about-reference__button"
          {% if section.settings.button_link == blank %}
            href="{{ routes.all_products_collection_url }}"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M16 10a4 4 0 0 1-8 0M3.1 6.03h17.8M3.4 5.47A2 2 0 0 0 3 6.67V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.67a2 2 0 0 0-.4-1.2l-2-2.67A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Reference about story",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Script accent text",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A folding table, one blend, and a farmers market."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Gina holding a bag of Crunchy Girl Granola in the kitchen"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption",
      "default": "Gina with our Original blend — the one that started it all."
    },
    {
      "type": "richtext",
      "id": "story",
      "label": "Story",
      "default": "<p>Every good story has to start somewhere, and ours began back in 2019 with a folding table, a handful of bags of granola, and a hopeful spot at the Clearfork Farmers Market in Fort Worth. We had one blend — our Original — and figured if folks liked it well enough to come back for more, we'd count ourselves fortunate.</p><p>As it turns out, people have a way of encouraging a good thing. Before long, one blend became six. Along came gluten-free, nut-free, sugar-free, and a parade of seasonal favorites that seem to disappear about as quickly as they're made.</p><p>Then, in July of 2026, we took a leap of faith and opened The Granola Shop on The Circle in the heart of Fort Worth. We still set up at our weekend markets around Fort Worth, because that's where this story began.</p><p>We're especially fond of our Go Crunchy refill discount — bring back your jar, fill it again from our bulk bins, and we'll knock a little off the price. For those who like a little adventure with their breakfast, we've laid out freeze-dried fruits, toasted coconut, and marshmallows so you can build a granola that's every bit as individual as you are.</p><p>Our Instagram and Facebook pages keep track of our weekly wanderings, and our online store is always open. We've always believed life's a little better with good company, honest ingredients, and something wonderfully delicious to start the day. We'd be honored to share all three with you.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "— Gina & the Crunchy Girl team"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Granola"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 104
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 104
    }
  ],
  "presets": [
    {
      "name": "Reference about story"
    }
  ]
}
{% endschema %}
