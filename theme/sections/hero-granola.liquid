{%- style -%}
  .section-{{ section.id }}-padding {
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient brand-hero-full section-{{ section.id }}-padding">
  <div class="brand-hero-full__grid{% if section.settings.image_position == 'left' %} brand-hero-full__grid--image-first{% endif %}">
    <div class="brand-hero-full__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="brand-hero__eyebrow brand-script">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="brand-hero__heading {{ section.settings.heading_size }}">
        {%- if section.settings.heading_line_1 != blank -%}
          <span class="brand-hero__heading-line">{{ section.settings.heading_line_1 }}</span><br>
        {%- endif -%}
        {%- if section.settings.heading_line_2 != blank -%}
          <span class="brand-hero__heading-line brand-hero__heading-line--accent">{{ section.settings.heading_line_2 }}</span><br>
        {%- endif -%}
        {%- if section.settings.heading_line_3 != blank -%}
          <span class="brand-hero__heading-line">{{ section.settings.heading_line_3 }}</span>
        {%- endif -%}
      </h1>

      {%- if section.settings.subheading != blank -%}
        <div class="brand-hero__subheading rte">{{ section.settings.subheading }}</div>
      {%- endif -%}

      <div class="brand-hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="button button--primary brand-hero__cta"
          >
            {%- render 'icon-brand', name: 'package', size: 16 -%}
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}

        {%- if section.settings.support_text != blank -%}
          <span class="brand-hero__support">{{ section.settings.support_text }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.show_email_signup -%}
        {%- assign hero_signup_id_prefix = 'HeroSignup-' | append: section.id -%}
        {%- render 'brand-email-signup',
          eyebrow: section.settings.signup_eyebrow,
          eyebrow_image: 'scoop-transparent.svg',
          placeholder: section.settings.signup_placeholder,
          button_label: section.settings.signup_button_label,
          microcopy: section.settings.signup_microcopy,
          id_prefix: hero_signup_id_prefix
        -%}
      {%- endif -%}
    </div>

    <div class="brand-hero-full__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag: loading: 'eager', fetchpriority: 'high', widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw'
        }}
      {%- else -%}
        {%- comment -%}
          Ships with the theme so the hero always has a photo, even before a
          merchant picks one in the theme editor.
        {%- endcomment -%}
        <img
          src="{{ 'hero-granola.jpg' | asset_url }}"
          alt="{{ section.settings.heading_line_1 | escape }}"
          loading="eager"
          fetchpriority="high"
          width="1600"
          height="2000"
        >
      {%- endif -%}

      {%- if section.settings.rating_label != blank or section.settings.rating_quote != blank -%}
        <div class="brand-hero-full__rating-card">
          <div class="brand-hero-full__rating-stars">
            {%- for i in (1..5) -%}
              {%- render 'icon-brand', name: 'star', size: 16 -%}
            {%- endfor -%}
            {%- if section.settings.rating_label != blank -%}
              <span>{{ section.settings.rating_label }}</span>
            {%- endif -%}
          </div>
          {%- if section.settings.rating_quote != blank -%}
            <p class="brand-hero-full__rating-quote">&ldquo;{{ section.settings.rating_quote }}&rdquo;</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Granola hero",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Script accent text",
      "default": "Hi, y'all —"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Small-Batch Granola,"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (accent color)",
      "default": "This is the Good Stuff!"
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Heading line 3",
      "default": "Made in Fort Worth."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" },
        { "value": "hxl", "label": "XX large" }
      ],
      "default": "hxl"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Handcrafted by Gina. No mystery ingredients — just real food that actually tastes like it should.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Granola"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "support_text",
      "label": "Supporting text",
      "default": "Ships nationwide via USPS within 24 hours · 2–3 day delivery"
    },
    {
      "type": "header",
      "content": "Email signup"
    },
    {
      "type": "checkbox",
      "id": "show_email_signup",
      "label": "Show email signup",
      "default": true
    },
    {
      "type": "text",
      "id": "signup_eyebrow",
      "label": "Signup eyebrow",
      "default": "Go Crunchy"
    },
    {
      "type": "text",
      "id": "signup_placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "signup_button_label",
      "label": "Button label",
      "default": "I'm in."
    },
    {
      "type": "text",
      "id": "signup_microcopy",
      "label": "Microcopy",
      "default": "Get discounts, fresh batch drops, and rewards straight to your inbox."
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Floating card label",
      "default": "Loved in Fort Worth"
    },
    {
      "type": "text",
      "id": "rating_quote",
      "label": "Floating card quote",
      "default": "Actually addictive."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Granola hero"
    }
  ]
}
{% endschema %}
