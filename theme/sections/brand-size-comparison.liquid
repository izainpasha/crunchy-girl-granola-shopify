{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  The illustration has sizes, prices and handful counts baked into the
  artwork ($16 / $20 / $25 / $45). Only show it when this product's variants
  have exactly those prices; otherwise (e.g. Apple Cinnamon, Trail Mix at
  $24 / $30 / $36 / $65) render the same comparison from live variant data so
  shoppers never see a price that differs from checkout.
{%- endcomment -%}
{%- liquid
  assign illustration_matches = true
  if product != blank
    for variant in product.variants
      case variant.title
        when '12oz Bag'
          assign illustrated_price = 1600
        when '32oz Jar'
          assign illustrated_price = 2000
        when 'Half Batch'
          assign illustrated_price = 2500
        when 'Full Batch'
          assign illustrated_price = 4500
        else
          assign illustrated_price = -1
      endcase
      if variant.price != illustrated_price
        assign illustration_matches = false
      endif
    endfor
  endif
-%}

<div class="brand-size-comparison color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if illustration_matches -%}
      <div class="brand-size-comparison__viewport" role="region" aria-label="Granola size comparison" tabindex="0">
        <img
          class="brand-size-comparison__image"
          src="{{ 'size-comparison-illustrated.jpg' | asset_url }}"
          alt="How much is in each size: 12oz Bag, $16, about 8 handfuls; 32oz Jar, $20, about 10 handfuls; Half Batch, $25, about 13 handfuls; Full Batch, $45, two bags, about 26 handfuls combined."
          width="1549"
          height="1015"
          loading="lazy"
          decoding="async"
        >
      </div>
    {%- else -%}
      <div class="brand-size-comparison__live">
        <h2 class="brand-size-comparison__heading">How much is in each size?</h2>
        <ul class="brand-size-comparison__grid" role="list">
          {%- for variant in product.variants -%}
            {%- liquid
              case variant.title
                when '12oz Bag'
                  assign handfuls = '~8 handfuls'
                when '32oz Jar'
                  assign handfuls = '~10 handfuls'
                when 'Half Batch'
                  assign handfuls = '~13 handfuls'
                when 'Full Batch'
                  assign handfuls = '~26 handfuls combined'
                else
                  assign handfuls = ''
              endcase
            -%}
            <li class="brand-size-comparison__card">
              {%- render 'icon-brand', name: 'scoop', size: 32 -%}
              <span class="brand-size-comparison__size">{{ variant.title | escape }}</span>
              <span class="brand-size-comparison__price">{{ variant.price | money_without_trailing_zeros }}</span>
              {%- if handfuls != blank -%}
                <span class="brand-size-comparison__handfuls">{{ handfuls }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Size comparison",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Size comparison"
    }
  ]
}
{% endschema %}
