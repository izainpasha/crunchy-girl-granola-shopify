{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="brand-newsletter">
      <div class="brand-newsletter__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="brand-hero__eyebrow brand-script">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="brand-newsletter__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>

      <div class="brand-newsletter__form">
        {%- form 'customer', class: 'brand-newsletter__form-el' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="brand-newsletter__field">
            <input
              id="NewsletterForm-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="brand-newsletter__input"
              value="{{ form.email }}"
              aria-label="{{ section.settings.placeholder | escape }}"
              placeholder="{{ section.settings.placeholder }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              required
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="NewsletterForm-error-{{ section.id }}"
              {% endif %}
            >
            <button type="submit" class="button button--primary brand-newsletter__button">
              {{ section.settings.button_label }}
            </button>
          </div>
          {%- if form.errors -%}
            <small class="brand-newsletter__message" id="NewsletterForm-error-{{ section.id }}">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </small>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="brand-newsletter__message brand-newsletter__message--success" tabindex="-1" autofocus>
              {{ 'newsletter.success' | t }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter signup",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Script accent text",
      "default": "psst —"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first bag."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Join the crunch club for fresh-batch drops, new flavors, and Texas-sized discounts."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "you@sweethome.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get my 10% off"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Newsletter signup"
    }
  ]
}
{% endschema %}
