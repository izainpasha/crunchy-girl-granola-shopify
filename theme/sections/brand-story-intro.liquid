{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="brand-story-intro__grid{% if section.settings.image_position == 'left' %} brand-story-intro__grid--image-first{% endif %}">
      <div class="brand-story-intro__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="brand-hero__eyebrow brand-script">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="brand-story-intro__body rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="button button--primary"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
      <div class="brand-story-intro__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 45vw, 100vw'
          }}
        {%- else -%}
          {%- liquid
            case section.settings.fallback_image
              when 'hero-granola.jpg'
                assign fallback_width = 1920
                assign fallback_height = 1440
              when 'texture-oat.jpg'
                assign fallback_width = 1600
                assign fallback_height = 800
              else
                assign fallback_width = 900
                assign fallback_height = 900
            endcase
          -%}
          <img
            src="{{ section.settings.fallback_image | asset_url }}"
            alt=""
            loading="lazy"
            width="{{ fallback_width }}"
            height="{{ fallback_height }}"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Story intro",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Script accent text",
      "default": "The beginning"
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Fallback image (used only if no image is picked below)",
      "options": [
        { "value": "hero-granola.jpg", "label": "Hero granola" },
        { "value": "granola-birthday-cake.jpg", "label": "Birthday cake" },
        { "value": "granola-apple.jpg", "label": "Apple" },
        { "value": "granola-original.jpg", "label": "Original" },
        { "value": "granola-trail.jpg", "label": "Trail" },
        { "value": "texture-oat.jpg", "label": "Oat texture" }
      ],
      "default": "granola-birthday-cake.jpg"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From a kitchen table in Fort Worth."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Gina started baking granola for her own kids because everything at the store had a mile-long ingredient list. Friends kept asking for a bag of their own — Crunchy Girl Granola is what happened next.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Story intro"
    }
  ]
}
{% endschema %}
