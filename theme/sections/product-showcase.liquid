{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if section.settings.show_texture -%}
    #shopify-section-{{ section.id }} .brand-products--texture {
      background-image: linear-gradient(rgba(251, 246, 236, 0.86), rgba(251, 246, 236, 0.86)),
        url({{ 'texture-oat.jpg' | asset_url }});
    }
  {%- endif -%}
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient brand-products{% if section.settings.show_texture %} brand-products--texture{% endif %}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="brand-products__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="brand-hero__eyebrow brand-script">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
          class="button button--primary brand-products__header-cta"
        >
          {%- render 'icon-brand', name: 'package', size: 16 -%}
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <div class="brand-products__grid">
      {%- assign showcase_collection = collections[section.settings.collection] -%}
      {%- assign showcase_products = showcase_collection.products -%}
      {%- if section.settings.curated_products != blank -%}
        {%- assign showcase_products = section.settings.curated_products -%}
      {%- endif -%}
      {%- if showcase_products != blank -%}
        {%- for product in showcase_products limit: section.settings.products_to_show -%}
          <a href="{{ product.url }}" class="brand-product-card">
            <div class="brand-product-card__media">
              {%- assign card_image = product.media.first.preview_image | default: product.featured_media.preview_image -%}
              {%- assign card_image_alt = card_image.alt | default: product.title -%}
              {%- if card_image -%}
                {{
                  card_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 750, 900',
                    sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw',
                    alt: card_image_alt
                }}
              {%- else -%}
                {%- comment -%}
                  Ships with the theme so a card still has a photo before a
                  merchant adds real product images.
                {%- endcomment -%}
                {%- assign fallback_index = forloop.index0 | modulo: 4 -%}
                {%- case fallback_index -%}
                  {%- when 0 -%}
                    {%- assign fallback_image = 'granola-birthday-cake.jpg' -%}
                  {%- when 1 -%}
                    {%- assign fallback_image = 'granola-apple.jpg' -%}
                  {%- when 2 -%}
                    {%- assign fallback_image = 'granola-original.jpg' -%}
                  {%- else -%}
                    {%- assign fallback_image = 'granola-trail.jpg' -%}
                {%- endcase -%}
                <img
                  src="{{ fallback_image | asset_url }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                  width="900"
                  height="900"
                >
              {%- endif -%}
              {%- render 'brand-product-card-tag', card_product: product -%}
            </div>
            <div class="brand-product-card__body">
              <h3 class="brand-product-card__title">{{ product.title }}</h3>
              {%- if product.description != blank -%}
                <p class="brand-product-card__desc">{{ product.description | strip_html | truncatewords: 14 }}</p>
              {%- endif -%}
              <div class="brand-product-card__row">
                <span class="brand-product-card__price">
                  {%- if product.price_varies -%}
                    {%- assign product_price = product.price | money_without_trailing_zeros -%}
                    {{ 'products.product.price.from_price_html' | t: price: product_price }}
                  {%- else -%}
                    {{ product.price | money_without_trailing_zeros }}
                  {%- endif -%}
                </span>
                <span class="button button--primary brand-product-card__cta">
                  {%- render 'icon-brand', name: 'package', size: 14 -%}
                  View
                </span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product showcase",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Script accent text",
      "default": "Four flavors, one obsession"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick your crunch."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subtext",
      "default": "Every batch is toasted low-and-slow, packed with clusters, and shipped USPS within 24 hours of your order."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Granola"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection"
    },
    {
      "type": "product_list",
      "id": "curated_products",
      "label": "Products shown",
      "limit": 8
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_texture",
      "label": "Show scattered-ingredients background texture",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Product showcase"
    }
  ]
}
{% endschema %}
