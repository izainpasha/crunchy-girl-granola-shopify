{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="brand-faq__grid">
      <div class="brand-faq__list">
        {%- if section.settings.eyebrow != blank -%}
          <p class="brand-hero__eyebrow brand-script">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <div class="brand-faq__accordion">
          {%- for block in section.blocks -%}
            <details class="brand-faq__item" {{ block.shopify_attributes }}>
              <summary>
                <span class="brand-faq__question">{{ block.settings.question }}</span>
                <span class="brand-faq__toggle" aria-hidden="true"></span>
              </summary>
              <div class="brand-faq__answer rte">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
      <div class="brand-faq__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag: loading: 'lazy', widths: '400, 600, 800, 900', sizes: '(min-width: 990px) 40vw, 100vw'
          }}
        {%- else -%}
          {%- liquid
            case section.settings.fallback_image
              when 'hero-granola.jpg'
                assign fallback_width = 1920
                assign fallback_height = 1440
              when 'texture-oat.jpg'
                assign fallback_width = 1600
                assign fallback_height = 800
              else
                assign fallback_width = 900
                assign fallback_height = 900
            endcase
          -%}
          <img
            src="{{ section.settings.fallback_image | asset_url }}"
            alt=""
            loading="lazy"
            width="{{ fallback_width }}"
            height="{{ fallback_height }}"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Script accent text",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Fallback image (used only if no image is picked above)",
      "options": [
        { "value": "hero-granola.jpg", "label": "Hero granola" },
        { "value": "granola-birthday-cake.jpg", "label": "Birthday cake" },
        { "value": "granola-apple.jpg", "label": "Apple" },
        { "value": "granola-original.jpg", "label": "Original" },
        { "value": "granola-trail.jpg", "label": "Trail" },
        { "value": "texture-oat.jpg", "label": "Oat texture" }
      ],
      "default": "granola-trail.jpg"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What's in the bag?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Real oats, real nuts, real fruit — no mystery ingredients.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How fresh is the granola when it ships?",
            "answer": "<p>Every bag is baked to order and shipped within days — never sitting on a shelf.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Is it safe for nut-free households?",
            "answer": "<p>Our Birthday Cake flavor is baked nut-free. Check each product page for allergen details.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does it stay fresh?",
            "answer": "<p>Enjoy within 6 weeks of baking for the best crunch — store sealed in a cool, dry spot.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do you ship outside the US?",
            "answer": "<p>Right now we ship within the continental US only. Come back soon for more.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
