{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 0;
    padding-bottom: 0;
  }
{%- endstyle -%}

<div class="brand-page-hero brand-page-hero--{{ section.settings.height }}">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2000
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '750, 1100, 1500, 2000',
        sizes: '100vw',
        class: 'brand-page-hero__image'
    }}
  {%- else -%}
    {%- liquid
      case section.settings.fallback_image
        when 'hero-granola.jpg'
          assign fallback_width = 1920
          assign fallback_height = 1440
        when 'texture-oat.jpg'
          assign fallback_width = 1600
          assign fallback_height = 800
        else
          assign fallback_width = 900
          assign fallback_height = 900
      endcase
    -%}
    <img
      src="{{ section.settings.fallback_image | asset_url }}"
      class="brand-page-hero__image"
      alt=""
      loading="eager"
      fetchpriority="high"
      width="{{ fallback_width }}"
      height="{{ fallback_height }}"
    >
  {%- endif -%}
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
    <span class="brand-page-hero__shade" aria-hidden="true"></span>
    <div class="page-width brand-page-hero__inner">
      <div class="brand-page-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="brand-hero__eyebrow brand-script brand-page-hero__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="brand-page-hero__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="brand-page-hero__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Brand page hero",
  "class": "section",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Fallback image (used only if no image is picked above)",
      "options": [
        { "value": "hero-granola.jpg", "label": "Hero granola" },
        { "value": "granola-birthday-cake.jpg", "label": "Birthday cake" },
        { "value": "granola-apple.jpg", "label": "Apple" },
        { "value": "granola-original.jpg", "label": "Original" },
        { "value": "granola-trail.jpg", "label": "Trail" },
        { "value": "texture-oat.jpg", "label": "Oat texture" }
      ],
      "default": "hero-granola.jpg"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Script accent text",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From our kitchen to yours."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "Brand page hero"
    }
  ]
}
{% endschema %}
